# GaiaSpeak Node.js Backend — Environment Variables
# Copy to .env and fill in values.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email delivery)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Public site URL (used in email links)
SITE_URL=https://gaiaspeak.io

# On-chain oracle (optional — only needed for push-prices / cron)
L2_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x...
ORACLE_PRIVATE_KEY=0x...

# Server
PORT=3001
